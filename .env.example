# Employee001 — environment template
# Copy this to `.env` and fill in your keys.
# Or run `npx employee001 setup` to do it interactively.

# Where Claude runs: anthropic (default), bedrock, vertex, foundry, or local.
EMPLOYEE001_MODEL_PROVIDER=anthropic

# Required only when EMPLOYEE001_MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AWS Bedrock: standard AWS credentials are discovered by the AWS runtime.
AWS_REGION=

# Google Vertex AI: standard Google Cloud credentials are discovered by the runtime.
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# Azure AI Foundry: standard Azure credentials are discovered by the runtime.
ANTHROPIC_FOUNDRY_RESOURCE=

# Local Anthropic-compatible endpoint (for example, Ollama >= 0.14). Use only
# with explicitly configured model IDs; Employee001 never guesses local names.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Boundary mode disables direct calls to api.anthropic.com by default. Set only
# when your organization explicitly permits those optional features.
EMPLOYEE001_ALLOW_DIRECT_ANTHROPIC=0

# Required. Composio MCP — Slack, Linear, GitHub, and 100+ more tool integrations.
# Get from https://app.composio.dev
COMPOSIO_API_KEY=

# Optional. ElevenLabs for cloned twin voices.
# Get from https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional. Optimizes the twins' memory — more accurate recall of the most
# relevant past context, so answers stay sharp over time. Works without it
# (memory falls back to keyword recall). Get from https://platform.openai.com
OPENAI_API_KEY=

# Bind address. Default 127.0.0.1 (only this machine can reach the app).
# Set to 0.0.0.0 to expose on your LAN — use a firewall or Tailscale!
EMPLOYEE001_BIND=127.0.0.1

# Shared-secret access token. Required when EMPLOYEE001_BIND is non-loopback;
# ignored when bound to 127.0.0.1. `npx employee001 setup` generates one
# automatically — only set this manually if you're skipping the wizard.
EMPLOYEE001_TOKEN=

# Local server port.
PORT=3000
