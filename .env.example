# Employee001 — environment template
# Copy this to `.env` and fill in your keys.
# Or run `npx employee001 setup` to do it interactively.

# Where Claude runs: anthropic (default), bedrock, vertex, foundry, or local.
EMPLOYEE001_MODEL_PROVIDER=anthropic

# Required only when EMPLOYEE001_MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AWS Bedrock: standard AWS credentials are discovered by the AWS runtime.
AWS_REGION=

# Google Vertex AI: standard Google Cloud credentials are discovered by the runtime.
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# Azure AI Foundry: standard Azure credentials are discovered by the runtime.
ANTHROPIC_FOUNDRY_RESOURCE=

# Local Anthropic-compatible endpoint (for example, Ollama >= 0.14). Use only
# with explicitly configured model IDs; Employee001 never guesses local names.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Boundary mode disables direct calls to api.anthropic.com by default. Set only
# when your organization explicitly permits those optional features.
EMPLOYEE001_ALLOW_DIRECT_ANTHROPIC=0

# Required. Composio MCP — Slack, Linear, GitHub, and 100+ more tool integrations.
# Get from https://app.composio.dev
COMPOSIO_API_KEY=

# Optional. ElevenLabs for cloned twin voices.
# Get from https://elevenlabs.io
ELEVENLABS_API_KEY=
# Use a restricted key: Text to Speech = Access, Speech to Text = Access,
# Voices = Read, everything else No Access, with a monthly credit limit
# (elevenlabs.io/app/developers/api-keys).
# Twin voice model. Default eleven_v4 (most expressive, 90+ languages); set
# eleven_flash_v2_5 for the lowest latency.
# ELEVENLABS_TTS_MODEL=eleven_v4
# Live voice on Ask (mic streams to Scribe v2 Realtime, answers spoken with
# Eleven v4 Turbo sentence by sentence). The browser connects to ElevenLabs
# with single-use tokens minted here; the key never leaves the server. Off in
# EU mode. off: back to record-then-transcribe.
# EMPLOYEE001_VOICE_LIVE=
# ELEVENLABS_LIVE_TTS_MODEL=eleven_v4_turbo

# Optional. Some hosted MCP servers (e.g. ElevenLabs) sign apps in with an
# OAuth Client ID Metadata Document instead of Dynamic Client Registration.
# Set this to a public https:// URL serving that JSON document; its client_id
# must equal the URL and its redirect_uris must include this install's
# http://localhost:<port>/api/org/mcp/oauth/callback.
# EMPLOYEE001_OAUTH_CLIENT_METADATA_URL=

# Optional. Optimizes the twins' memory — more accurate recall of the most
# relevant past context, so answers stay sharp over time. Works without it
# (memory falls back to keyword recall). Get from https://platform.openai.com
OPENAI_API_KEY=

# Bind address. Default 127.0.0.1 (only this machine can reach the app).
# Set to 0.0.0.0 to expose on your LAN — use a firewall or Tailscale!
EMPLOYEE001_BIND=127.0.0.1

# Extra hostnames allowed to reach a 127.0.0.1-bound app, comma-separated.
# Only needed behind a local proxy that keeps its own name in the Host header,
# e.g. `tailscale serve` (mac.tail1234.ts.net). Everything else is refused.
# EMPLOYEE001_ALLOWED_HOSTS=

# Bootstrap token. Required when EMPLOYEE001_BIND is non-loopback: open
# http://<host>:<port>/?token=<this> once to create the first owner account
# at /auth/setup; after that everyone signs in. Also the bearer for MCP
# clients. `npx employee001 setup` generates one automatically.
EMPLOYEE001_TOKEN=

# ── Sign-in (optional) ────────────────────────────────────────────────────
# Single sign-on with any OpenID Connect provider (Google Workspace, Entra
# ID, Okta…). Redirect URI defaults to $APP_URL/api/auth/oidc/callback.
# EMPLOYEE001_OIDC_ISSUER=
# EMPLOYEE001_OIDC_CLIENT_ID=
# EMPLOYEE001_OIDC_CLIENT_SECRET=
# EMPLOYEE001_OIDC_REDIRECT_URI=
# Unknown people with a verified email at these domains get a member account.
# EMPLOYEE001_OIDC_ALLOWED_DOMAINS=
# Separate bearer for MCP clients (defaults to EMPLOYEE001_TOKEN).
# EMPLOYEE001_MCP_TOKEN=

# ── Data residency and privacy (optional, see SECURITY.md) ─────────────────
# eu: Claude only via Bedrock eu-*/Vertex europe-*/local, embeddings only to
# EMBEDDINGS_BASE_URL, voice only via an EU ElevenLabs endpoint.
# EMPLOYEE001_REGION=
# OpenAI-compatible embeddings endpoint (EU or local), e.g. http://localhost:11434/v1
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_API_KEY=
# EU voice: https://api.eu.residency.elevenlabs.io (ElevenLabs Enterprise)
# ELEVENLABS_BASE_URL=
# off: no voice at all (server or browser speech recognition)
# EMPLOYEE001_VOICE=
# Memory redaction of personal data: off | basic (default) | strict
# EMPLOYEE001_MEMORY_REDACT=
# Set to 1 once zero data retention is on for your Composio project
# COMPOSIO_ZERO_DATA_RETENTION=
# Post Slack replies as the org's bot instead of the employee's account
# SLACK_BOT_TOKEN=

# Local server port.
PORT=3000
